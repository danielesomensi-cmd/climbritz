# Frontend environment variables
# Copy to .env.local and fill in values

# URL of the backend API for web/dev builds only.
# IGNORED in mobile builds (NEXT_PUBLIC_MOBILE=true) — those are hardcoded
# to Railway in app/lib/api.ts so a localhost value here can't leak into APK/IPA.
NEXT_PUBLIC_API_URL=http://localhost:8001

# Clerk authentication (A019)
# Get the publishable key from your Clerk dashboard: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
