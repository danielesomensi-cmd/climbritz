# Backend (Railway or local dev)
DATABASE_URL=sqlite:///./kilter.db
GEMINI_API_KEY=get-from-https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
UPLOAD_DIR=uploads
BOARDLIB_DB_PATH=data/kilter.db
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
ADMIN_SECRET=change-me-in-production

# Clerk authentication (A019)
# Get these from your Clerk dashboard: https://dashboard.clerk.com
# CLERK_JWKS_URL is REQUIRED when ENVIRONMENT=production (startup refuses to boot without it).
# Format: https://<your-clerk-frontend-api>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
